# Copy to .env in project root (backend loads from here)

# Required for embeddings + chat (recommended: gpt-4o-mini for cost/quality balance)
OPENAI_API_KEY=sk-your-key-here

# Optional: override defaults
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# RAG tuning (chunk size trade-off: smaller = precise citations, larger = cheaper embed calls)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_K=6

# Chroma persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=data/chroma

# Session memory window (messages kept per chat session)
MEMORY_WINDOW=10

# Optional: pip install faster-whisper, then set true for audio transcription
ENABLE_WHISPER=false
WHISPER_MODEL=base
